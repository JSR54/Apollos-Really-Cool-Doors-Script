local function isValidEntity(obj)
	if not obj or not obj.Parent then return false end
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	return true
end

local function findInWorkspace(names)
	for _, n in ipairs(names) do
		local d = workspace:FindFirstChild(n)
		if isValidEntity(d) then return d end
	end
	return nil
end

local function findInContainer(container, names)
	if not container then return nil end
	for _, n in ipairs(names) do
		local d = container:FindFirstChild(n)
		if isValidEntity(d) then return d end
	end
	return nil
end

local function getEntity(kind)
	if kind == "Rush" then return findInWorkspace({"RushMoving"}) end
	if kind == "Sally" then return findInWorkspace({"SallyMoving"}) end
	if kind == "Ambush" then return findInWorkspace({"AmbushMoving"}) end
	if kind == "Jeff" then return findInWorkspace({"JeffTheKiller"}) end
	if kind == "Scribbles" then return findInWorkspace({"Scribbles"}) end
	if kind == "Bramble" then return findInWorkspace({"LiveEntityBramble"}) end
	if kind == "Drones" then return findInWorkspace({"Drones"}) end
	if kind == "Eyes" then return findInWorkspace({"Eyes"}) end
	if kind == "Blitz" then return findInWorkspace({"BackdoorRush"}) end
	if kind == "A60" then return findInWorkspace({"A60"}) end
	if kind == "A120" then return findInWorkspace({"A120"}) end
	if kind == "Bash" then return findInWorkspace({"BashMoving"}) end
	if kind == "Lookman" then return findInWorkspace({"BackdoorLookman"}) end
	if kind == "Seek" then return findInWorkspace({"SeekMoving", "Seek"}) end

	if kind == "Screech" then
		local cam = workspace:FindFirstChild("Camera")
		return findInContainer(cam, {"Screech"})
	end

	if kind == "Teller" then
		local live = workspace:FindFirstChild("LiveEntities")
		return findInContainer(live, {"TellerRig", "Teller"})
	end

	if kind == "Creak" then
		local live = workspace:FindFirstChild("LiveEntities")
		return findInContainer(live, {"Creak"})
	end

	if kind == "Figure" then
		local rooms = workspace:FindFirstChild("CurrentRooms")
		if rooms then
			for _, room in ipairs(rooms:GetChildren()) do
				local fs = room:FindFirstChild("FigureSetup")
				if fs then
					local rig = fs:FindFirstChild("FigureRig")
					if isValidEntity(rig) then return rig end
				end
			end
		end
		return nil
	end

	return nil
end

