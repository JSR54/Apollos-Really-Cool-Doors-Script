local bookCache = {}
local function scanForBooks()
	table.clear(bookCache)
	local rooms = workspace:FindFirstChild("CurrentRooms")
	if not rooms then return end
	for _, room in ipairs(rooms:GetChildren()) do
		local assets = room:FindFirstChild("Assets")
		if assets then
			for _, shelf in ipairs(assets:GetChildren()) do
				if typeof(shelf) == "Instance" and shelf.Name:match("^Bookshelves") then
					for _, child in ipairs(shelf:GetChildren()) do
						if child.Name == "LiveHintBook" then
							table.insert(bookCache, child)
						end
					end
				end
			end
		end
	end
end
local function getBooks()
	for i = #bookCache, 1, -1 do
		local b = bookCache[i]
		if not b or not b.Parent then table.remove(bookCache, i) end
	end
	if #bookCache == 0 then scanForBooks() end
	return bookCache
end

local function findKeyInRoom(room)
	local key = room:FindFirstChild("KeyObtain", true)
	if key then return key end
	key = room:FindFirstChild("Key", true)
	if key then return key end
	return nil
end

local function findLeverInRoom(room)
	local lever = room:FindFirstChild("LeverForGate", true)
	if lever then return lever end
	local function walk(parent, depth)
		if depth > 2 then return nil end
		for _, child in ipairs(parent:GetChildren()) do
			local lname = child.Name:lower()
			if lname:find("lever") then return child end
			if child:IsA("Folder") or child:IsA("Model") then
				local found = walk(child, depth + 1)
				if found then return found end
			end
		end
		return nil
	end
	return walk(room, 1)
end

local function addEntityESP(obj, name, color)
	if not obj or not obj.Parent then return end
	pcall(function()
		local target = obj
		if not (obj:IsA("Model") or obj:IsA("BasePart")) then
			target = obj:FindFirstChildWhichIsA("Model", true)
				or obj:FindFirstChildWhichIsA("BasePart", true)
			if not target then return end
		end

		local existing = target:FindFirstChild(name)
		if existing then
			if existing:IsA("Highlight") then
				if existing.Adornee ~= target then existing.Adornee = target end
				if existing.FillColor ~= color then existing.FillColor = color end
				if existing.OutlineColor ~= color then existing.OutlineColor = color end
			end
			return
		end

		local h = Instance.new("Highlight")
		h.Name = name
		h.Adornee = target
		h.FillColor = color
		h.OutlineColor = color
		h.FillTransparency = 0.4
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = target
	end)
end

local function addBillboard(obj, nameTag, displayText, textColor, bgColor)
	if not obj or not obj.Parent then return end
	pcall(function()
		local adornee = obj
		if not obj:IsA("BasePart") then
			adornee = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
			if not adornee then return end
		end

		local existing = adornee:FindFirstChild(nameTag)
		if existing then
			local lbl = existing:FindFirstChildWhichIsA("TextLabel", true)
			if lbl and lbl.Text ~= displayText then lbl.Text = displayText end
			return
		end

		local bb = Instance.new("BillboardGui")
		bb.Name = nameTag
		bb.Adornee = adornee
		bb.Size = UDim2.fromOffset(150, 26)
		bb.StudsOffset = Vector3.new(0, 2.5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = adornee

		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = bgColor or Color3.fromRGB(15, 15, 20)
		bg.BackgroundTransparency = 0.15
		bg.BorderSizePixel = 0
		bg.Parent = bb
		Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)

		local stroke = Instance.new("UIStroke")
		stroke.Color = textColor or Color3.fromRGB(255, 255, 255)
		stroke.Thickness = 1
		stroke.Transparency = 0.5
		stroke.Parent = bg

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Text = displayText
		text.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
		text.Font = Enum.Font.GothamBold
		text.TextSize = 14
		text.Parent = bg
	end)
end

local EXACT_DOOR_NAMES = {
	["Door"] = true,
	["Door1"] = true,
	["Door2"] = true,
	["ElevatorDoor"] = true,
	["DoorLeft"] = true,
	["DoorRight"] = true,
}

local function resolveDoorObject(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
		return obj.Parent
	end
	if obj:IsA("Model") or obj:IsA("BasePart") then
		return obj
	end
	return nil
end

local function collectDoorsInRoom(room)
	local doors = {}
	local seen = {}

	local function tryAdd(obj)
		if not obj then return end
		if not EXACT_DOOR_NAMES[obj.Name] then return end
		if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end

		local resolved = resolveDoorObject(obj)
		if not resolved then return end
		if seen[resolved] then return end
		seen[resolved] = true
		table.insert(doors, resolved)
	end

	for _, child in ipairs(room:GetChildren()) do
		tryAdd(child)
		if child:IsA("Folder") or child:IsA("Model") then
			for _, sub in ipairs(child:GetChildren()) do
				tryAdd(sub)
			end
		end
	end
	return doors
end

local function cleanup()
	for _, conn in pairs(connections) do
		if typeof(conn) == "RBXScriptConnection" and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(connections)
end

local function onCharacterAdded(char)
	cleanup()
	character = char
	root = char:WaitForChild("HumanoidRootPart", 8)
	humanoid = char:WaitForChild("Humanoid", 8)
	if not root or not humanoid then return end

	table.insert(connections, RunService.Stepped:Connect(function()
		if not character or not character.Parent then return end
		if noclip then
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
	end))

	table.insert(connections, RunService.Heartbeat:Connect(function(dt)
		if not fly or not root or not root.Parent then return end
		root.Anchored = true
		humanoid.PlatformStand = true
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local look = camera.CFrame.LookVector
		local right = camera.CFrame.RightVector
		local up = camera.CFrame.UpVector
		local dir = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += look end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= look end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += right end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= right end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += up end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= up end

		if dir.Magnitude > 0 then
			root.CFrame = CFrame.new(root.Position + dir.Unit * speed * dt) * camera.CFrame.Rotation
		else
			root.CFrame = CFrame.new(root.Position) * camera.CFrame.Rotation
		end
	end))
end

