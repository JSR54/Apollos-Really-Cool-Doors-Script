local function stackOffset(slot)
	return (slot - 1) * (ACH_HEIGHT + ACH_GAP)
end

local function reflowWarnings()
	for i, data in ipairs(activeWarnings) do
		TweenService:Create(data.frame, TweenInfo.new(0.32, Enum.EasingStyle.Quint), {
			Position = UDim2.new(1, VISIBLE_X, BASE_Y, stackOffset(i))
		}):Play()
	end
end

