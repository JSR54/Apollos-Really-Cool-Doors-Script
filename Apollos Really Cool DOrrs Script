local function createSwitch(parent, text, xPos, yPos, callback)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(210, 34)
	holder.Position = UDim2.fromOffset(xPos, yPos)
	holder.BackgroundTransparency = 1
	holder.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0, 130, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(230, 230, 230)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local track = Instance.new("TextButton")
	track.Size = UDim2.fromOffset(48, 24)
	track.Position = UDim2.new(1, -52, 0.5, -12)
	track.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = holder
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.Position = UDim2.fromOffset(2, 2)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.Parent = track
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local enabled = false
	local function setState(newState)
		if enabled == newState then return end
		enabled = newState
		local pos = enabled and UDim2.fromOffset(26, 2) or UDim2.fromOffset(2, 2)
		local col = enabled and Color3.fromRGB(70, 200, 110) or Color3.fromRGB(55, 55, 60)
		TweenService:Create(knob, TweenInfo.new(0.18), {Position = pos}):Play()
		TweenService:Create(track, TweenInfo.new(0.18), {BackgroundColor3 = col}):Play()
		callback(enabled)
	end

	track.MouseButton1Click:Connect(function()
		setState(not enabled)
	end)

	return setState
end

local function createButton(parent, text, xPos, yPos, width, callback)
	local btn = Instance.new("TextButton")
